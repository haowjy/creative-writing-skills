#!/usr/bin/env bash
# Pre-commit hook for creative-writing-skills.
# Front-loads the checks that protect the committed plugin distribution so
# breakage is caught here, at commit time, instead of in CI (which only runs
# on main) or by a user whose marketplace add fails.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass a single commit: git commit --no-verify

set -uo pipefail

# Paths `mars build plugin` owns.
PLUGIN_PATHS=(plugin .claude-plugin .cursor-plugin package.json)

fail=0

if command -v mars >/dev/null 2>&1; then
  echo "pre-commit: package and committed plugin output (mars build plugin + check)..."
  if ! mars build plugin; then
    fail=1
  elif ! mars check; then
    fail=1
  fi
  if [ "$fail" -eq 0 ]; then
    # Compare the rebuilt worktree against the index: any difference means the
    # commit does not contain what `mars build plugin` produced.
    stale=$(git diff --name-only -- "${PLUGIN_PATHS[@]}")
    untracked=$(git ls-files --others --exclude-standard -- "${PLUGIN_PATHS[@]}")
    if [ -n "$stale$untracked" ]; then
      echo >&2
      echo "pre-commit: plugin output differs from the index after rebuild:" >&2
      printf '%s\n' "$stale" "$untracked" | grep -v '^$' | sed 's/^/  /' >&2
      echo "pre-commit: the build is committed output — stage it and commit again." >&2
      fail=1
    fi
  fi
else
  echo "pre-commit: 'mars' not on PATH — skipping package and plugin checks." >&2
  echo "             install it with: uv tool install 'mars-agents==0.20.6'" >&2
fi

if [ "$fail" -eq 0 ]; then
  echo "pre-commit: agent and skill references (scripts/check_refs.py)..."
  if ! python3 scripts/check_refs.py; then
    fail=1
  fi
fi

if command -v claude >/dev/null 2>&1; then
  echo "pre-commit: plugin validation (manifest, components, marketplace)..."
  if ! claude plugins validate plugin/claude; then
    fail=1
  fi
  if ! claude plugins validate .claude-plugin/marketplace.json; then
    fail=1
  fi
else
  echo "pre-commit: 'claude' not on PATH — skipping plugin validation." >&2
fi

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "pre-commit: checks failed. Fix the above, or bypass with 'git commit --no-verify'." >&2
  exit 1
fi

echo "pre-commit: ok."
